# Copy this file to .env and fill in the values. Never commit .env.

PORT=5000

# MongoDB connection string (MongoDB Atlas, or a local MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27018/bugsight

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET= daeff272b2fd18e1e77b33661e418b19deb05661238fbd2fec192467eee7d05e19478ad746ea28a1e23cd9ba98faa5d0

JWT_EXPIRES_IN=7d

# Frontend URL(s) allowed to call this server (comma separated).
# The FIRST one is used to build the password reset link in emails.
CLIENT_URL=https://localhost:5173,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:8000,http://localhost:8001

# Google OAuth client ID (same value as VITE_GOOGLE_CLIENT_ID in the frontend)
GOOGLE_CLIENT_ID=

# Password reset emails. For Gmail use an App Password, not your real password.
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@example.com
EMAIL_PASS=your-provider-app-password
EMAIL_FROM="SDP for GitHub <your-email@example.com>"
