# Copy this file to .env and fill in the values. Never commit .env.

PORT=5000

# MongoDB connection string (MongoDB Atlas, or a local MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/sdp_auth

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=71b39f52fa87b42de7601255f949986456de77bf1cac64aef6fbf349d8ba3a53db7629b14c6af25d963a14420b071501
JWT_EXPIRES_IN=7d

# Frontend URL(s) allowed to call this server (comma separated).
# The FIRST one is used to build the password reset link in emails.
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Google OAuth client ID (same value as VITE_GOOGLE_CLIENT_ID in the frontend)
GOOGLE_CLIENT_ID=

# Password reset emails. For Gmail use an App Password, not your real password.
EMAIL_SERVICE=gmail
EMAIL_USER=himadri.bahuguna23@st.niituniversity.in
EMAIL_PASS=xzldetqsamfoesoy
EMAIL_FROM="SDP for GitHub <himadri.bahuguna23@st.niituniversity.in>"
