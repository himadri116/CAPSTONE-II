# Copy to .env and fill in. Never commit .env.

# Public URL users open in the browser (nginx serves the app and proxies /api)
CLIENT_URL=http://localhost:3000

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorised redirect URI must equal GOOGLE_CALLBACK_URL
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me

# LLM suggestions (optional; without a key the app shows rule-based advice)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# Local demo login button. Ignored when NODE_ENV=production.
DEV_AUTH=false
NODE_ENV=production

# Used by Jenkins/compose to name images
IMAGE_PREFIX=yourdockerhubuser
TAG=latest
